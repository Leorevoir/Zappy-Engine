{
    /**
    * Window rules
    */
    "window": {
        "title": "Zappy",
        "size": {
            "width": 1280,
            "height": 720
        },
        "fullscreen": false,
        "vsync": true,
        "max_fps": 60,
        "resizable": true,
        "quit_key": "Escape",
        "icon": "assets/icon.png" //TODO: add icons
    },
    /**
    * Graphics rules
    */
    "graphics": {
        "clear_color": [
            0.1,
            0.1,
            0.1,
            1.0
        ], // RGBA format
        "antialiasing": true
    }
    /**
    * Scene rules
    */
}
